<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Store builds: no CarPlay entitlement until Apple approves the driving-task category
	     (see docs/CARPLAY_ENTITLEMENT.md). Debug builds use Runner.entitlements, which has it. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.jeronimotech.mzdOwner</string>
	</array>
</dict>
</plist>
