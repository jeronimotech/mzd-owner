<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- CarPlay "driving task" category. Works in the iOS Simulator's CarPlay window during
	     development; running on a real car needs Apple's approval for this entitlement
	     (https://developer.apple.com/contact/carplay). -->
	<key>com.apple.developer.carplay-driving-task</key>
	<true/>
	<!-- Shared with the MiMazdaWidget extension (widget + Live Activity data). -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.jeronimotech.mzdOwner</string>
	</array>
</dict>
</plist>
